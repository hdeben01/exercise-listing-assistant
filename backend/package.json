{
  "name": "listing-assistant-backend",
  "version": "1.0.0",
  "description": "API Service backend for the listing assistant application",
  "license": "ISC",
  "author": "Hugo de Benito",
  "type": "module",
  "main": "app.ts",
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "ignore": [
      "*.test.ts"
    ],
    "execMap": {
      "ts": "node"
    }
  },
  "scripts": {
    "dev": "nodemon --env-file=.env src/server.ts",
    "test": "node --env-file=.env ./node_modules/vitest/vitest.mjs run",
    "test:mock": "TEST_MODE=MOCK node --env-file=.env ./node_modules/vitest/vitest.mjs run",
    "test:api": "TEST_MODE=API node --env-file=.env ./node_modules/vitest/vitest.mjs run",
    "mock": "MODE=MOCK nodemon --env-file=.env src/server.ts",
    "api": "MODE=API nodemon --env-file=.env src/server.ts"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
